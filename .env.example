DATABASE_URL=postgres://apex:apex123@localhost:5432/wf_engine
PORT=3000
STORAGE_BACKEND=local
STORAGE_PATH=./storage
RUST_LOG=info
# Swagger UI (/swagger-ui) + OpenAPI spec (/api-docs/openapi.json). Default açık;
# prod'da kapatmak için ENABLE_SWAGGER=false.
ENABLE_SWAGGER=true

# Ek-belge (attachment) deposu — WFD JSON storage'ından AYRI. Bu değerler DEPLOYMENT
# VARSAYILANIDIR; bir WFD kendi deposunu $env'de aynı adlı anahtarlarla geçersiz kılabilir
# (bkz. docs/spec/decisions.md — "Ek-belge deposu WFD BAŞINA").
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_STORAGE_PATH=../work-pool-portal/storage
# ATTACHMENT_STORAGE_S3_BUCKET=
# ATTACHMENT_STORAGE_S3_REGION=
# ATTACHMENT_STORAGE_S3_ENDPOINT=
# ATTACHMENT_STORAGE_S3_ACCESS_KEY_ID=
# ATTACHMENT_STORAGE_S3_SECRET_ACCESS_KEY=
